# ═══════════════════════════════════════════════════════════════════════════════
# Oracle Worker Dockerfile
# Async score ingestion, consensus, and chain publication service via Kafka
# ═══════════════════════════════════════════════════════════════════════════════

# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

# Copy go mod files for dependency caching
COPY replay-api/go.mod replay-api/go.sum ./replay-api/
COPY replay-common/go.mod ./replay-common/
COPY resource-ownership/go-common/go.mod ./resource-ownership/go-common/
COPY resource-ownership/go-mongodb/go.mod ./resource-ownership/go-mongodb/

# Download dependencies
WORKDIR /app/replay-api
RUN go mod download

# Copy source code
WORKDIR /app
COPY replay-api/ ./replay-api/
COPY replay-common/ ./replay-common/
COPY resource-ownership/ ./resource-ownership/

# Build the oracle worker binary
WORKDIR /app/replay-api
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/oracle-worker ./cmd/oracle-worker

# Runtime stage
FROM alpine:3.19

WORKDIR /app

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata

# Copy binary from builder
COPY --from=builder /app/oracle-worker /app/oracle-worker

# Non-root user for security
RUN adduser -D -g '' appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8081
CMD ["./oracle-worker"]
